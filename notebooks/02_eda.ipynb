    "def tipoEtiqueta(g):\n",
    "    if g in config.ETIQUETAS_MARKETING: return \"marketing\"\n",
    "    if g in config.AVISO_CONTENIDO: return \"aviso de contenido\"\n",
    "    if g in config.GENEROS_JUEGO: return \"género\"\n",
    "    return \"otro\"\n",
    "\n",
    "def resumenEtiquetas(d, col, minimo=100):\n",
    "    e = d[[col, \"pct_pos\", \"dif_cohorte\"]].explode(col).dropna(subset=[col])\n",
    "    r = e.groupby(col).agg(juegos=(\"pct_pos\", \"size\"), media=(\"pct_pos\", \"mean\"), dif_cohorte=(\"dif_cohorte\", \"mean\"))\n",
    "    return r.query(\"juegos >= @minimo\").sort_values(\"juegos\", ascending=False)\n",
    "\n",
    "gen = resumenEtiquetas(m, \"lista_gen\")\n",
    "gen[\"tipo\"] = [tipoEtiqueta(g) for g in gen.index]\n",
    "guardarMetrica(gen, \"02_eda_generos\")\n",
    "display(gen.round(3))\n",
    "print(f\"Géneros distintos tras normalizar: {len(set(g for L in u.lista_gen for g in L))} · juegos sin género en la muestra: {int((m.lista_gen.map(len) == 0).sum())}\")\n",
    "\n",
    "g = gen.sort_values(\"dif_cohorte\")\n",
    "fig, ax = plt.subplots(figsize=(8, 5))\n",
    "paleta = {\"género\": COLOR, \"marketing\": COLOR_2, \"aviso de contenido\": \"#8c564b\", \"otro\": \"gray\"}\n",
    "ax.barh(g.index, g.dif_cohorte, color=[paleta[t] for t in g.tipo])\n",
    "ax.axvline(0, color=\"k\", lw=.8)\n",
    "ax.set(title=\"Figura 9. Recepción vs. su cohorte por género / etiqueta (≥100 juegos)\", xlabel=\"dif_cohorte medio\")\n",
    "handles = [plt.Rectangle((0, 0), 1, 1, color=c) for c in paleta.values()]\n",
    "ax.legend(handles, paleta.keys(), loc=\"lower right\", fontsize=8)\n",
    "guardarFigura(fig, \"02_eda_09_generos\"); plt.show()\n",
    "R[\"peor_genero\"] = (g.index[0], g.dif_cohorte.iloc[0]); R[\"mejor_genero\"] = (g.index[-1], g.dif_cohorte.iloc[-1])\n",
    "R[\"n_generos\"] = len(set(x for L in u.lista_gen for x in L))"
