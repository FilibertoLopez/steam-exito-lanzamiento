   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "def wilsonInf(pos, n, z=1.96):\n",
    "    p = pos / n\n",
    "    return (p + z * z / (2 * n) - z * np.sqrt((p * (1 - p) + z * z / (4 * n)) / n)) / (1 + z * z / n)\n",
    "\n",
    "m[\"wilson\"] = wilsonInf(m.positive, m.n_rev)\n",
    "m[\"pct_cohorte\"] = m.groupby(\"anio\").pct_pos.rank(pct=True)\n",
    "m[\"bueno\"] = (m.pct_cohorte >= 0.75).astype(int)\n",
    "m[\"dif_cohorte\"] = m.pct_pos - m.groupby(\"anio\").pct_pos.transform(\"mean\")\n",
    "\n",
    "var = m[[\"pct_pos\", \"wilson\", \"pct_cohorte\", \"dif_cohorte\"]]\n",
    "corr_var = var.corr(\"spearman\")\n",
    "display(corr_var.round(3))\n",
    "anual_v = m.groupby(\"anio\")[[\"pct_pos\", \"wilson\", \"pct_cohorte\"]].mean().loc[2012:]\n",
    "\n",
    "fig, ax = plt.subplots(1, 3, figsize=(14, 3.8))\n",
    "for col, c, t in [(\"pct_pos\", COLOR, \"pct_pos\"), (\"wilson\", COLOR_2, \"límite inferior de Wilson\")]:\n",
    "    ax[0].hist(m[col], bins=40, alpha=.6, color=c, label=t)\n",
    "ax[0].legend(); ax[0].set(title=\"Figura 4a. pct_pos vs Wilson\", xlabel=\"valor\")\n",
    "ax[1].hist(m.pct_cohorte, bins=20, color=COLOR); ax[1].set(title=\"Figura 4b. Percentil dentro de la cohorte\", xlabel=\"percentil\")\n",
    "for col, c in [(\"pct_pos\", COLOR), (\"wilson\", COLOR_2), (\"pct_cohorte\", \"gray\")]:\n",
    "    ax[2].plot(anual_v.index, anual_v[col], marker=\"o\", color=c, label=col)\n",
    "ax[2].legend(); ax[2].set(title=\"Figura 4c. Media anual de cada variante\", xlabel=\"año de lanzamiento\")\n",
    "guardarFigura(fig, \"02_eda_04_objetivo_variantes\"); plt.show()\n",
    "print(f\"Etiqueta «bueno» (cuartil superior de su cohorte): {m.bueno.mean():.1%} de la muestra\")\n",
    "R[\"rho_wilson\"] = corr_var.loc[\"pct_pos\", \"wilson\"]"
   ],
   "outputs": []
  },
