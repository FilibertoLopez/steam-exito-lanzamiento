    "ax.plot(anual.index, anual[\"media\"], marker=\"s\", color=COLOR_2, label=\"media\")\n",
    "ax.set(title=\"Figura 6. La recepción por año de lanzamiento no es estacionaria\", xlabel=\"año de lanzamiento\", ylabel=\"pct_pos\"); ax.legend()\n",
    "guardarFigura(fig, \"02_eda_06_deriva\"); plt.show()\n",
    "R[\"media_2014\"], R[\"media_2024\"] = anual.loc[2014, \"media\"], anual.loc[2024, \"media\"]\n",
    "\n",
    "# Partición temporal propuesta: 70 / 15 / 15 por fecha de lanzamiento\n",
    "c1, c2 = m.fecha.quantile(config.FRACCION_TRAIN), m.fecha.quantile(config.FRACCION_TRAIN + config.FRACCION_VALID)\n",
    "m[\"conjunto\"] = np.where(m.fecha <= c1, \"train\", np.where(m.fecha <= c2, \"valid\", \"test\"))\n",
    "res = m.groupby(\"conjunto\").agg(juegos=(\"pct_pos\", \"size\"), desde=(\"fecha\", \"min\"), hasta=(\"fecha\", \"max\"), media=(\"pct_pos\", \"mean\"), desv=(\"pct_pos\", \"std\")).loc[[\"train\", \"valid\", \"test\"]]\n",
    "display(res)\n",
    "guardarMetrica(res, \"02_eda_particion_propuesta\")\n",
    "\n",
    "tr, te = m[m.conjunto == \"train\"], m[m.conjunto == \"test\"]\n",
    "rmse = lambda y, p: float(np.sqrt(np.mean((y - p) ** 2)))\n",
    "base_media = rmse(te.pct_pos, tr.pct_pos.mean())\n",
    "base_cohorte = rmse(te.pct_pos, te.groupby(\"anio\").pct_pos.transform(\"mean\"))\n",
    "print(f\"Referencia ingenua (media del train) en test: RMSE = {base_media:.4f} · sesgo = {te.pct_pos.mean() - tr.pct_pos.mean():+.3f}\")\n",
    "print(f\"Tasa base de la cohorte (oráculo, usa la media del propio año): RMSE = {base_cohorte:.4f}\")\n",
    "print(f\"Desviación del test: {te.pct_pos.std():.4f}\")\n",
    "R.update(cut_train=c1.date(), cut_valid=c2.date(), rmse_media=base_media, rmse_cohorte=base_cohorte, sesgo_test=te.pct_pos.mean() - tr.pct_pos.mean(), n_train=len(tr), n_test=len(te))"
